{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CityFit: Start server",
      "type": "shell",
      "command": "npm",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "4173"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cityfit",
        "pattern": {
          "regexp": "^(__never_matches__)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "CityFit: http://localhost:4173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
